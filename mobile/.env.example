# Membership API base URL (includes /api suffix)
# Local worker example:
EXPO_PUBLIC_API_BASE=http://127.0.0.1:8787/ms/membership-app/api

# Physical device on the same network — use your machine LAN IP:
# EXPO_PUBLIC_API_BASE=http://192.168.1.10:8787/ms/membership-app/api

# Deployed worker example:
# EXPO_PUBLIC_API_BASE=https://your-worker.example.com/ms/membership-app/api
